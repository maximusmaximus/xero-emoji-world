# --- sim-server ---
PORT=8787
# Seed for the procedural city. Change it and you get a different world.
CITY_SEED=xero-emoji-world
# Simulation tick interval in ms (each tick emits 1..N actions)
TICK_MS=1000
ACTIONS_PER_TICK=6
# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ACTIONS=xew_actions
QDRANT_COLLECTION_ENTITIES=xew_entities
# Embedder: "hash" (local deterministic, no network, good for offline/dev) | "openai-compatible"
# For production semantic search, use Venice.ai (private, OpenAI-compatible embeddings).
# See docs/SECRETS.md for key management. NEVER commit real keys.
EMBEDDER=hash
EMBED_DIM=256
# Example for Venice.ai (uncomment and set key):
# EMBEDDER=openai-compatible
# EMBED_API_URL=https://api.venice.ai/api/v1/embeddings
# EMBED_MODEL=text-embedding-bge-m3
# EMBED_DIM=1024
# EMBED_API_KEY=your_venice_api_key_here
EMBED_API_URL=https://api.x.ai/v1/embeddings
EMBED_API_KEY=
EMBED_MODEL=
# Backups: periodic snapshot interval (minutes) and directory
BACKUP_INTERVAL_MIN=60
BACKUP_DIR=./backups
BACKUP_KEEP=48
# --- web ---
VITE_SIM_URL=http://localhost:8787
