# --- sim-server ---
PORT=8787
# Seed for the procedural city. Change it and you get a different world.
CITY_SEED=xero-emoji-world
# Simulation tick interval in ms (each tick emits 1..N actions)
TICK_MS=1000
ACTIONS_PER_TICK=6
# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ACTIONS=xew_actions
QDRANT_COLLECTION_ENTITIES=xew_entities
# Embedder: "hash" (local deterministic, no network, offline-friendly) | "openai-compatible"
# Recommended for production semantic search: Venice.ai (private, OpenAI-compatible)
# Set EMBEDDER=openai-compatible and the values below. Changing dim requires new Qdrant collections.
EMBEDDER=hash
EMBED_DIM=256
# For Venice.ai:
# EMBED_API_URL=https://api.venice.ai/api/v1/embeddings
# EMBED_API_KEY=your-venice-inference-key-here   # NEVER commit real keys. Use .env (gitignored) or GitHub Actions secrets.
# EMBED_MODEL=text-embedding-bge-m3               # or other from https://docs.venice.ai/models/embeddings ; set EMBED_DIM to match (e.g. 1024 for bge-m3)
EMBED_API_URL=
EMBED_API_KEY=
EMBED_MODEL=
# Backups: periodic snapshot interval (minutes) and directory
BACKUP_INTERVAL_MIN=60
BACKUP_DIR=./backups
BACKUP_KEEP=48
# --- web ---
VITE_SIM_URL=http://localhost:8787
