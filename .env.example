# --- sim-server ---
PORT=8787
# Seed for the procedural city. Change it and you get a different world.
CITY_SEED=xero-emoji-world
# Simulation tick interval in ms (each tick emits 1..N actions)
TICK_MS=1000
ACTIONS_PER_TICK=6
# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ACTIONS=xew_actions
QDRANT_COLLECTION_ENTITIES=xew_entities
# Embedder: "hash" (local deterministic, no network, offline/CI) | "openai-compatible"
# Production memory model: text-embedding-qwen3-8b (private, 4096-d).
# Production voice model:  grok-4-20 (private), reasoning_effort=none.
# The key has $1 of inference per Pacific day. See docs/MODELS.md.
# NEVER commit real keys. Copy this file to .env (gitignored).
EMBEDDER=hash
EMBED_DIM=256
# Uncomment to power the world with Venice (new Qdrant collections required):
# EMBEDDER=openai-compatible
# EMBED_API_URL=https://api.venice.ai/api/v1/embeddings
# EMBED_MODEL=text-embedding-qwen3-8b
# EMBED_DIM=4096
# EMBED_API_KEY=
# WORLD_MODEL=grok-4-20
# WORLD_API_URL=https://api.venice.ai/api/v1/chat/completions
EMBED_API_URL=
EMBED_API_KEY=
EMBED_MODEL=
# Oracle: model inference that steers world development (era names, prophecies,
# new emoji recipes, wonders, behaviour weights). "auto" = LLM if a key is set, else local.
ORACLE=auto
ORACLE_API_URL=https://api.x.ai/v1/chat/completions
# Falls back to XAI_API_KEY if unset. Never commit a real key.
ORACLE_API_KEY=
ORACLE_MODEL=grok-4.7
# Consult the oracle every N ticks (120 ticks ≈ 2 min at TICK_MS=1000)
ORACLE_EVERY_TICKS=120
ORACLE_TIMEOUT_MS=30000
# Daily cap (USD, per UTC day) on ESTIMATED oracle spend; over it the built-in local oracle decides.
ORACLE_DAILY_BUDGET_USD=1
# USD per 1M tokens used for the estimate. Defaults are conservative; check current xAI pricing for your model.
ORACLE_PRICE_INPUT_PER_M=3
ORACLE_PRICE_CACHED_INPUT_PER_M=0.75
ORACLE_PRICE_OUTPUT_PER_M=15
# Where the day's spend is persisted (survives restarts). Defaults to $BACKUP_DIR/oracle-budget.json.
# ORACLE_BUDGET_PATH=./backups/oracle-budget.json
WORLD_MODEL=grok-4-20
WORLD_API_URL=https://api.venice.ai/api/v1/chat/completions
DAILY_BUDGET_USD=1
# Backups: periodic snapshot interval (minutes) and directory
BACKUP_INTERVAL_MIN=60
BACKUP_DIR=./backups
BACKUP_KEEP=48
# --- web ---
VITE_SIM_URL=http://localhost:8787
